# Copy to .env and fill in. .env is gitignored and never reaches the frontend.

# Claude API key — used server-side only, for document extraction (and Phase 4 analysis).
# Leave empty to run the app without LLM extraction (documents are stored, extraction skipped).
ANTHROPIC_API_KEY=

# Oura Ring connector — Personal Access Token (server-side only).
# Create one at https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN=

# Optional overrides
# CEO_HEALTH_DB_PATH=data/ceo_health.db
# CEO_HEALTH_DOCUMENTS_DIR=data/documents
# EXTRACT_MODEL=claude-sonnet-4-6
